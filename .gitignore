# ---- Dependencies ----
# Matches node_modules at any depth (root, client/, server/, nested)
node_modules/

# ---- Environment variables / secrets ----
# Never commit real env files; commit a .env.example template instead
.env
.env.*
!.env.example

# ---- Lock files ----
# (kept ignored per project preference — see note: normally lock files ARE committed)
client/package-lock.json
server/package-lock.json

# ---- Build outputs ----
dist/
dist-ssr/
build/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Caches & runtime ----
.cache/
.vite/
coverage/
*.pid
*.seed

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Misc local / scratch ----
*.local
tempCodeRunnerFile.js

# ---- Project-specific ----
CLAUDE.md
